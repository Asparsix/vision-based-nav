<?xml version="1.0"?>
<sdf version="1.8">
  <model name="ugv_bot">
    <!-- Axle height = wheel radius. Spawn with z ~= 0.09 -->
    <pose>0 0 0.09 0 0 0</pose>

    <link name="base_footprint"/>

    <link name="base_link">
      <pose>0 0 0.10 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.14</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.20</iyy><iyz>0</iyz><izz>0.22</izz>
        </inertia>
      </inertial>
      <collision name="chassis_col">
        <geometry><box><size>0.55 0.34 0.12</size></box></geometry>
      </collision>
      <visual name="chassis_vis">
        <geometry><box><size>0.55 0.34 0.12</size></box></geometry>
        <material>
          <ambient>0.12 0.32 0.70 1</ambient>
          <diffuse>0.18 0.42 0.88 1</diffuse>
        </material>
      </visual>
      <visual name="nose_vis">
        <pose>0.24 0 0.0 0 0 0</pose>
        <geometry><box><size>0.10 0.20 0.06</size></box></geometry>
        <material>
          <ambient>0.10 0.28 0.60 1</ambient>
          <diffuse>0.15 0.35 0.75 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Drive wheels: centers at z=0 (model frame) → touch ground -->
    <link name="wheel_left_link">
      <pose>0.06 0.20 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.003</iyy><iyz>0</iyz><izz>0.003</izz>
        </inertia>
      </inertial>
      <collision name="wl_col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry>
      </collision>
      <visual name="wl_vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="wl_hub">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.055</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose>0.06 -0.20 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.003</iyy><iyz>0</iyz><izz>0.003</izz>
        </inertia>
      </inertial>
      <collision name="wr_col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry>
      </collision>
      <visual name="wr_vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="wr_hub">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.055</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rear caster: silver ball + fork, same ground contact as drive wheels -->
    <link name="caster_link">
      <pose>-0.24 0 0 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0005</iyy><iyz>0</iyz><izz>0.0005</izz>
        </inertia>
      </inertial>
      <collision name="caster_ball_col">
        <geometry><sphere><radius>0.09</radius></sphere></geometry>
      </collision>
      <visual name="caster_ball_vis">
        <geometry><sphere><radius>0.09</radius></sphere></geometry>
        <material>
          <ambient>0.70 0.70 0.75 1</ambient>
          <diffuse>0.90 0.90 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="caster_fork">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.05 0.10 0.08</size></box></geometry>
        <material>
          <ambient>0.35 0.35 0.40 1</ambient>
          <diffuse>0.50 0.50 0.55 1</diffuse>
        </material>
      </visual>
      <visual name="caster_stem">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.08</length></cylinder></geometry>
        <material>
          <ambient>0.40 0.40 0.45 1</ambient>
          <diffuse>0.55 0.55 0.60 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Stereo camera mount (baseline 0.08 m). Left is primary RGB for segmentation. -->
    <link name="camera_link">
      <pose>0.28 0 0.18 0 0.12 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="cam_col">
        <geometry><box><size>0.05 0.14 0.05</size></box></geometry>
      </collision>
      <visual name="cam_vis">
        <geometry><box><size>0.05 0.14 0.05</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="camera_left_link">
      <pose>0.28 0.04 0.18 0 0.12 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz>
        </inertia>
      </inertial>
      <sensor name="camera_left" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>stereo/left/image_raw</topic>
        <gz_frame_id>camera_left_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <camera_info_topic>stereo/left/camera_info</camera_info_topic>
        </camera>
      </sensor>
      <!-- Legacy alias for UNet / RTAB remaps -->
      <sensor name="camera_mono_alias" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_left_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <camera_info_topic>camera/camera_info</camera_info_topic>
        </camera>
      </sensor>
      <!-- Stable Gazebo depth aligned with left (used as Depth block for VSLAM). -->
      <sensor name="depth_camera" type="depth_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>camera/depth/image_raw</topic>
        <gz_frame_id>camera_left_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.10</near>
            <far>20.0</far>
          </clip>
          <camera_info_topic>camera/depth/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </link>

    <link name="camera_right_link">
      <pose>0.28 -0.04 0.18 0 0.12 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz>
        </inertia>
      </inertial>
      <sensor name="camera_right" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>stereo/right/image_raw</topic>
        <gz_frame_id>camera_right_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <camera_info_topic>stereo/right/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </link>

    <link name="imu_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <!-- Fixed caster (stable balance); visually a free-rolling ball -->
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <joint name="camera_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_left_link</child>
    </joint>
    <joint name="camera_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_right_link</child>
    </joint>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.40</wheel_separation>
      <wheel_radius>0.09</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <!-- Wheel odom only; ROS EKF owns odom→base_footprint TF (do not bridge wheel/tf). -->
      <odom_topic>wheel/odom</odom_topic>
      <tf_topic>wheel/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </model>
</sdf>
