<?xml version="1.0"?>
<sdf version="1.8">
  <model name="simple_wall">
    <static>true</static>
    <link name="link">
      <collision name="col">
        <geometry><box><size>4.0 0.25 2.4</size></box></geometry>
      </collision>
      <visual name="vis">
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>4.0 0.25 2.4</size></box></geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://textures/brick.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
