<?xml version="1.0"?>
<sdf version="1.8">
  <model name="simple_chair">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.25 0 0 0</pose>
      <collision name="seat_col">
        <geometry><box><size>0.45 0.45 0.08</size></box></geometry>
      </collision>
      <visual name="seat">
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>0.45 0.45 0.08</size></box></geometry>
        <material>
          <ambient>0.2 0.25 0.55 1</ambient>
          <diffuse>0.25 0.35 0.75 1</diffuse>
        </material>
      </visual>
      <visual name="back">
        <cast_shadows>false</cast_shadows>
        <pose>0 0.2 0.3 0 0 0</pose>
        <geometry><box><size>0.45 0.06 0.55</size></box></geometry>
        <material>
          <ambient>0.2 0.25 0.55 1</ambient>
          <diffuse>0.25 0.35 0.75 1</diffuse>
        </material>
      </visual>
      <visual name="leg">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 -0.2 0 0 0</pose>
        <geometry><box><size>0.4 0.4 0.35</size></box></geometry>
        <material>
          <ambient>0.35 0.25 0.15 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://textures/wood.png</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
