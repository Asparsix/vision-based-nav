<?xml version="1.0"?>
<sdf version="1.8">
  <model name="ugv_bot">
    <pose>0 0 0.12 0 0 0</pose>
    <link name="base_footprint"/>
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.12</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.18</iyy><iyz>0</iyz><izz>0.20</izz>
        </inertia>
      </inertial>
      <collision name="chassis_col">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>0.50 0.32 0.14</size></box></geometry>
      </collision>
      <visual name="chassis_vis">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>0.50 0.32 0.14</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.75 1</ambient>
          <diffuse>0.2 0.45 0.9 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="wheel_left_link">
      <pose>0 0.18 0 0 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.002</iyy><iyz>0</iyz><izz>0.002</izz>
        </inertia>
      </inertial>
      <collision name="wl_col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="wl_vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="wheel_right_link">
      <pose>0 -0.18 0 0 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.002</iyy><iyz>0</iyz><izz>0.002</izz>
        </inertia>
      </inertial>
      <collision name="wr_col">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="wr_vis">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="caster_link">
      <pose>-0.18 0 -0.01 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz><izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name="caster_col">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
      </collision>
      <visual name="caster_vis">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="camera_link">
      <pose>0.22 0 0.12 0 0.15 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="cam_col">
        <geometry><box><size>0.04 0.10 0.04</size></box></geometry>
      </collision>
      <visual name="cam_vis">
        <geometry><box><size>0.04 0.10 0.04</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <camera_info_topic>camera/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </link>
    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </model>
</sdf>
